{
  "name": "spendly-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Spendly - AI-powered Personal Finance Dashboard",
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "install:frontend": "npm install --prefix frontend",
    "install:backend": "npm install --prefix backend",
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "test:backend": "npm test --prefix backend",
    "test:frontend": "npm test --prefix frontend",
    "test:all": "npm test --prefix backend && npm test --prefix frontend"
  }
}
